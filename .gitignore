# Firmware build files
# ============================================================

# PlatformIO
**/.pio/
**/.pioenvs/
**/.piolibdeps/

# Generic build/output folders
**/build/
**/dist/
**/out/

# Compiled firmware
*.elf
*.map
*.hex
*.bin
*.uf2

# Python / MicroPython
**/__pycache__/
*.py[cod]
*.pyo

# Local virtual environments
.venv/
venv/
env/

# ============================================================
# Editors and IDEs
# ============================================================

.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

.idea/
*.code-workspace

# ============================================================
# Operating system files
# ============================================================

Thumbs.db
Desktop.ini
.DS_Store

# ============================================================
# Runtime science data
# ============================================================

# Measured competition samples belong to a run, not to the source tree.
# Backed up with the procedure in Documentation/OPERATIONS.md.
firmware/BD/data/samples.json
firmware/BD/data/*.json.tmp

# Downloaded source archives for DB3. 21 MB of third-party data does not
# belong in version control; DB3.json is rebuilt from it with
# py firmware/research/import_usgs.py --download
firmware/BD/data/.cache/

# Calibrations are produced per instrument, per run.
firmware/BD/data/calibration_active.json
firmware/BD/data/FREYA_FULL_SPECTRAL_CAL_*.json

# ============================================================
# Local secrets and machine-specific settings
# ============================================================

.env
.env.*
secrets.py
wifi_config.py
config.local.*
